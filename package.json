{
  "name": "arena-combat",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "dev": "node scripts/prepare-engine.mjs && vite",
    "build": "node scripts/prepare-engine.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/prepare-engine.mjs && tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:upstream": "tsx --test vendor/stick-steel/tests/duel.test.ts",
    "arena": "node scripts/prepare-engine.mjs && tsx src/cli.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/three": "0.180.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
